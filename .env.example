# Servidor
PORT=3000
NODE_ENV=development

# Segredo para assinar os JWT de sessao de sala. GERE UM VALOR FORTE e NUNCA comite o real.
# Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-em-producao
# Tempo de vida do JWT de sessao. Precisa cobrir a duracao esperada de uma
# partida para que reconexoes (F5 / voltar pelo link) funcionem sem re-login.
JWT_EXPIRES_IN=6h

# CORS / origem do frontend. Suporta LISTA separada por virgula para varios
# frontends (ex: boardzando.rpgzando.com + quiz.rpgzando.com + localhost).
WEB_ORIGIN=http://localhost:5173,http://localhost:5174

# Argon2id (parametros OWASP 2024 como base)
ARGON_MEMORY_KIB=19456
ARGON_TIME_COST=2
ARGON_PARALLELISM=1

# ---------- Music Quiz ----------
# Senha unica para acessar o painel admin do quiz (/admin no quiz-web).
# So quem tem essa senha pode criar salas e editar quizzes. Deixe vazio para
# desligar todos os endpoints admin.
ADMIN_PASSWORD=

# Diretorio onde ficam tracks.json + assets/audio + assets/covers.
# Se ausente, o servidor tenta <repo>/data/musicquiz.
# QUIZ_DATA_DIR=

# Spotify (fase 3+): credenciais de app registradas em https://developer.spotify.com/dashboard
# CLIENT_ID e publico (vai para o cliente); CLIENT_SECRET fica so no servidor.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
